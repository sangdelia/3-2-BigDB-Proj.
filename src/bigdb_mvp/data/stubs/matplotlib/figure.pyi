from pathlib import Path

from matplotlib.axes import Text

class Figure:
    def set_facecolor(self, color: str) -> None: ...
    def supxlabel(self, text: str, *, fontsize: float, color: str) -> Text: ...
    def savefig(self, fname: str | Path, *, dpi: float) -> None: ...
    def suptitle(self, t: str) -> Text: ...
