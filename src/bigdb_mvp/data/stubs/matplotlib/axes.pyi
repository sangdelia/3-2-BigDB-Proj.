from collections.abc import Sequence

class Text: ...
class Annotation: ...
class BarContainer: ...
class Line2D: ...
class Legend: ...

class Spine:
    def set_visible(self, value: bool) -> None: ...

class Spines:
    def __getitem__(self, key: str | list[str]) -> Spine: ...

class Axis:
    def set_major_formatter(self, formatter: str) -> None: ...

class Axes:
    spines: Spines
    xaxis: Axis
    def set_facecolor(self, color: str) -> None: ...
    def set_axisbelow(self, value: bool) -> None: ...
    def tick_params(self, *, colors: str, labelsize: float) -> None: ...
    def barh(
        self,
        y: Sequence[str],
        width: Sequence[float],
        *,
        color: str | Sequence[str],
        left: Sequence[float] = ...,
        label: str = ...,
    ) -> BarContainer: ...
    def bar(
        self, x: Sequence[str], height: Sequence[float], *, color: str | Sequence[str]
    ) -> BarContainer: ...
    def bar_label(
        self,
        container: BarContainer,
        labels: Sequence[str] | None = None,
        *,
        fmt: str = ...,
        padding: float = ...,
    ) -> list[Annotation]: ...
    def set_xlim(self, left: float, right: float) -> tuple[float, float]: ...
    def set_ylim(self, bottom: float, top: float) -> tuple[float, float]: ...
    def set_xlabel(self, xlabel: str, *, labelpad: float = ...) -> Text: ...
    def set_ylabel(self, ylabel: str) -> Text: ...
    def set_title(
        self,
        label: str,
        *,
        loc: str = ...,
        fontsize: float = ...,
        fontweight: str = ...,
        pad: float = ...,
    ) -> Text: ...
    def set_yscale(self, value: str) -> None: ...
    def plot(
        self, x: Sequence[float], y: Sequence[float], *, marker: str, label: str
    ) -> list[Line2D]: ...
    def legend(self, *, frameon: bool = ..., loc: str = ...) -> Legend: ...
    def grid(self, *, alpha: float, axis: str = ...) -> None: ...
