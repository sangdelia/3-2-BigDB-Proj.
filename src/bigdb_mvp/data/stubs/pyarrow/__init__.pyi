from collections.abc import Mapping, Sequence
from typing import TypeAlias, final

Scalar: TypeAlias = str | int | float | bool | None
ScalarColumn: TypeAlias = Sequence[Scalar]

ArrowInvalid: type[Exception]

def string() -> DataType: ...
def float32() -> DataType: ...
def schema(fields: Sequence[tuple[str, DataType]]) -> Schema: ...
def table(data: Mapping[str, ScalarColumn], schema: Schema | None = ...) -> Table: ...

@final
class Schema:
    @property
    def names(self) -> list[str]: ...
    def field(self, name: str) -> Field: ...

@final
class Field:
    @property
    def type(self) -> DataType: ...

@final
class DataType: ...

@final
class Table:
    @property
    def schema(self) -> Schema: ...
    @property
    def num_rows(self) -> int: ...
    def to_pylist(self) -> list[dict[str, str]]: ...

@final
class RecordBatch:
    def to_pylist(self) -> list[dict[str, str | float | None]]: ...
