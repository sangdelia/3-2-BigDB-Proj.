from collections.abc import Mapping, Sequence
from typing import TypeAlias, final

ScalarColumn: TypeAlias = Sequence[str | None] | Sequence[float | None]

def string() -> DataType: ...
def float32() -> DataType: ...
def schema(fields: Sequence[tuple[str, DataType]]) -> Schema: ...
def table(data: Mapping[str, ScalarColumn], schema: Schema) -> Table: ...

@final
class Schema:
    @property
    def names(self) -> list[str]: ...
    def field(self, name: str) -> Field: ...

@final
class Field:
    @property
    def type(self) -> DataType: ...

@final
class DataType: ...

@final
class Table:
    def to_pylist(self) -> list[dict[str, str]]: ...

@final
class RecordBatch:
    def to_pylist(self) -> list[dict[str, str | float | None]]: ...
