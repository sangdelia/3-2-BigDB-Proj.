from collections.abc import Iterator, Sequence
from os import PathLike
from types import TracebackType
from typing import Self

from pyarrow import RecordBatch, Schema, Table

def write_table(table: Table, where: str | PathLike[str]) -> None: ...
def read_table(
    source: str | PathLike[str], columns: Sequence[str] | None = ...
) -> Table: ...

class ParquetFile:
    def __init__(self, source: str | PathLike[str]) -> None: ...
    @property
    def schema_arrow(self) -> Schema: ...
    @property
    def metadata(self) -> FileMetaData: ...
    def iter_batches(
        self,
        batch_size: int = ...,
        columns: Sequence[str] | None = ...,
    ) -> Iterator[RecordBatch]: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class FileMetaData:
    @property
    def num_row_groups(self) -> int: ...
    def row_group(self, index: int) -> RowGroupMetaData: ...

class RowGroupMetaData:
    @property
    def num_columns(self) -> int: ...
    @property
    def num_rows(self) -> int: ...
    def column(self, index: int) -> ColumnChunkMetaData: ...

class ColumnChunkMetaData:
    @property
    def compression(self) -> str: ...
